# ==========================================
# AI DETECTIVE AGENCY - BACKEND ENVIRONMENT CONFIG
# ==========================================

# Tên dự án
PROJECT_NAME="AI Detective Case Game"

# Cấu hình CSDL PostgreSQL (Mặc định dùng SQLite cho môi trường dev local nếu chưa chạy Postgres)
# DATABASE_URL=postgresql://detective_user:detective_pass@localhost:5432/detective_db
DATABASE_URL=sqlite:///./detective.db

# ==========================================
# CẤU HÌNH AI GATEWAY 9ROUTER (LOCAL PROXY)
# ==========================================
# Endpoint OpenAI-compatible local của 9Router
LLM_API_BASE=http://localhost:20128/v1

# API Key để gọi 9Router Proxy (Điền Key của 9Router hoặc Keycard/OpenRouter vào đây)
LLM_API_KEY=sk-9router-local

# Model chỉ định qua 9Router Gateway
LLM_MODEL=openrouter/nvidia/nemotron-3-super-120b-a12b:free

# Nhiệt độ sinh kịch bản (0.0 để kết quả ổn định và bám sát Schema JSON)
LLM_TEMPERATURE=0.0
