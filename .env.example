# ==========================================
# UNSOLVED CASE FILES AI - CONFIGURATION TEMPLATE
# ==========================================

# 1. Cấu hình Endpoint LLM (OpenAI-Compatible Gateway)
# - Dùng 9Router: http://localhost:20128/v1 (API key: sk-9router-local)
# - Dùng OpenRouter: https://openrouter.ai/api/v1 (API key: sk-or-v1-...)
# - Dùng Google AI Studio: https://generativelanguage.googleapis.com/v1beta/openai/ (API key: AIzaSy...)
# - Dùng Ollama Local: http://localhost:11434/v1 (API key: ollama)
LLM_API_BASE=http://localhost:20128/v1
LLM_API_KEY=your_api_key_here

# 2. Tên Model LLM sử dụng
# - Khuyến nghị cho Production: gh/gpt-4o-mini
# - Mô hình nghiên cứu đối chuẩn: gh/gpt-4o, gemini/gemma-4-31b-it
LLM_MODEL=gh/gpt-4o-mini

# 3. Giới hạn số lần sửa lỗi cục bộ (Localized Patch Retries - Paper 7 ConWriter)
MAX_PATCH_RETRIES=2

# 4. Bảo mật chữ ký chống gian lận Client-Server (HMAC-SHA256 Anti-Tamper)
REQUIRE_CLIENT_SIGNATURE=true
GAME_CLIENT_SECRET=Phenikaa_UCF_AI_SecretKey_2026_SecureHmacKey_x9!

# 5. Cổng dịch vụ FastAPI Backend
PORT=8000
